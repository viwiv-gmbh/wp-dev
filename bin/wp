#!/bin/sh
# WP-CLI läuft im Container immer als www-data (Spec 017 B, WPorbit).
#
# WP-CLI lädt den Code der Site: Plugins, Themes, wp-config.php. Als root oder
# als dev erreichte dieser Code den SSH-Agent und die Claude-Anmeldung. Darum:
#   www-data → direkt
#   dev      → sudo -u www-data (einzige Regel in /etc/sudoers.d/wporbit-wp)
#   root     → setpriv nach www-data
# `--allow-root` wird entfernt: Es ist nie mehr nötig, und alte Befehle (Skills,
# Gewohnheit) laufen so weiter.
set -eu
PHAR=/usr/local/bin/wp-cli.phar

for arg do
    shift
    [ "$arg" = "--allow-root" ] && continue
    set -- "$@" "$arg"
done

case "$(id -un)" in
    www-data) exec "$PHAR" "$@" ;;
    root)
        # setpriv leert die Umgebung. Zurück kommt nur die Konfiguration der
        # Site: wp-config.php liest WORDPRESS_* (wp-config-docker.php des
        # offiziellen Images); ohne sie sucht WordPress die Datenbank unter
        # `mysql`. Für dev erledigt das env_keep in /etc/sudoers.d/wporbit-wp.
        set -- "$PHAR" "$@"
        for name in $(env | sed -n 's/^\(WORDPRESS_[A-Za-z0-9_]*\)=.*/\1/p' | sort -u); do
            # Eine Zeile aus einem mehrzeiligen Wert ist keine Variable.
            eval "[ -n \"\${$name+x}\" ]" || continue
            eval "set -- \"$name=\${$name}\" \"\$@\""
        done
        exec setpriv --reuid=www-data --regid=www-data --init-groups --reset-env -- \
            env HOME=/tmp PATH="$PATH" "$@" ;;
    *)  exec sudo -n -u www-data -- "$PHAR" "$@" ;;
esac
